# ── ZYRON environment ───────────────────────────────────────────────

# 1. STORAGE (optional)
# Without this, the console runs on an in-memory store: everything works,
# but state is lost when the server restarts. With it, approvals,
# commitments, messages and the audit trail persist.
# MongoDB Atlas free tier (M0) is enough. Paste the connection string here
# and remember to replace <password> with your real database password.
MONGODB_URI=
MONGODB_DB=zyron

# 2. MODEL (optional)
# Without a key the agent runs in deterministic simulation mode — routing,
# dispatch and the approval gate are all real, only the prose is rule-based.
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_NAME=ZYRON
